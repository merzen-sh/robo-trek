<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{> tailwind}}
</head>
<body class="bg-[#0d0d0c] text-[#e0dbd3] min-h-screen p-8 font-mono">
  <div class="max-w-2xl mx-auto">
    <div
      class="inline-flex items-center gap-1.5 bg-primary/10 border border-primary/20 text-primary-foreground text-[10px] font-semibold tracking-[0.2em] uppercase px-4 py-1 rounded shadow-neon mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      Robo Trek
    </div>
    <h1 class="text-2xl font-black tracking-tight mb-6">Tickets</h1>
    {{> navbar}}
    <ul class="space-y-3">
      {{#each tickets}}
      <li>
        <div class="flex items-center gap-2 bg-[#141413]/80 border border-white/10 rounded-lg px-4 py-3">
          <span class="w-1.5 h-1.5 rounded-full {{#if (eq status "open")}}bg-amber-400{{else if (eq status "in_progress")}}bg-sky-400{{else}}bg-[#8c877e]{{/if}}"></span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold truncate">{{subject}}</div>
            <div class="text-[11px] text-[#8c877e]">#{{id}} · {{username}} · {{opened_label}}</div>
          </div>
          <span class="text-[10px] font-semibold tracking-[0.2em] uppercase {{#if (eq status "open")}}text-amber-400{{else if (eq status "in_progress")}}text-sky-400{{else}}text-[#8c877e]{{/if}}">{{status}}</span>
        </div>
      </li>
      {{else}}
      <li class="text-[#8c877e]">No tickets yet.</li>
      {{/each}}
    </ul>
  </div>
</body>
</html>
