<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{> tailwind}}
  <script src="https://unpkg.com/htmx.org@2.0.10/dist/htmx.min.js"></script>
</head>
<body class="bg-[#0d0d0c] text-[#e0dbd3] min-h-screen p-8 font-mono">
  <div class="max-w-2xl mx-auto">
    <div
      class="inline-flex items-center gap-1.5 bg-primary/10 border border-primary/20 text-primary-foreground text-[10px] font-semibold tracking-[0.2em] uppercase px-4 py-1 rounded shadow-neon mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      Robo Trek
    </div>
    <h1 class="text-2xl font-black tracking-tight mb-6">Tickets</h1>
    {{> navbar}}
    <div id="ticket-filters" class="flex gap-2 mb-4">
      <input type="text" name="q" value="{{q}}" placeholder="Search subject, user, or id…"
        hx-get="/dashboard/tickets/fragment" hx-trigger="input changed delay:300ms, search"
        hx-include="#ticket-filters" hx-target="#tickets-list" hx-swap="innerHTML" hx-push-url="true"
        class="flex-1 min-w-0 bg-[#141413]/80 border border-white/10 rounded-lg px-3 py-2 text-sm text-[#e0dbd3] placeholder-[#8c877e] focus:outline-none focus:border-primary/50">
      <select name="status"
        hx-get="/dashboard/tickets/fragment" hx-trigger="change"
        hx-include="#ticket-filters" hx-target="#tickets-list" hx-swap="innerHTML" hx-push-url="true"
        class="bg-[#141413]/80 border border-white/10 rounded-lg px-3 py-2 text-sm text-[#e0dbd3] focus:outline-none focus:border-primary/50">
        <option value="">All statuses</option>
        <option value="open" {{#if (eq status "open")}}selected{{/if}}>Open</option>
        <option value="in_progress" {{#if (eq status "in_progress")}}selected{{/if}}>In progress</option>
        <option value="closed" {{#if (eq status "closed")}}selected{{/if}}>Closed</option>
      </select>
    </div>
    <div id="tickets-list">
      {{> tickets_list}}
    </div>
  </div>
</body>
</html>