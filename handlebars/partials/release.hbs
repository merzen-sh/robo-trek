<!DOCTYPE html>
<html lang="en">
{{> head}}
<body>
  <div class="tech-card p-4 w-full max-w-sm rounded-lg text-center overflow-hidden">
    <div class="card-effects"></div>
    <div
      class="inline-flex items-center gap-1.5 bg-primary/10 border border-primary/20 text-primary-foreground text-[10px] font-semibold tracking-[0.2em] uppercase px-4 py-1 rounded shadow-neon mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse shadow-neon-strong"></span>
      {{title}}
    </div>

    <div class="relative">
      <h1 class="relative text-4xl font-black text-foreground tracking-tight font-mono">
        {{content}}
      </h1>
    </div>
  </div>
</body>
</html>
