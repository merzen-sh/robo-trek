{{#if metrics}}
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
  <div class="bg-[#141413]/80 border border-white/10 rounded-lg p-4">
    <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#8c877e] mb-2">CPU</div>
    <div class="text-3xl font-black text-primary mb-2">{{metrics.cpu_percent}}%</div>
    <div class="h-2 rounded-full bg-white/10 overflow-hidden">
      <div class="h-full bg-primary transition-all duration-500" style="width: {{metrics.cpu_percent}}%"></div>
    </div>
  </div>
  <div class="bg-[#141413]/80 border border-white/10 rounded-lg p-4">
    <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#8c877e] mb-2">Memory</div>
    <div class="text-3xl font-black text-primary mb-2">{{metrics.mem_percent}}%</div>
    <div class="text-xs text-[#8c877e] mb-2">{{metrics.mem_used_mb}} MB / {{metrics.mem_total_mb}} MB</div>
    <div class="h-2 rounded-full bg-white/10 overflow-hidden">
      <div class="h-full bg-primary transition-all duration-500" style="width: {{metrics.mem_percent}}%"></div>
    </div>
  </div>
</div>
<script type="application/json" id="metrics-history">{{{history_json}}}</script>
{{else}}
<div class="bg-[#141413]/80 border border-white/10 rounded-lg p-4 text-[#8c877e]">Metrics unavailable.</div>
{{/if}}